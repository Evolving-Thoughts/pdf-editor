{
  "name": "pdf-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "fixtures:real": "node scripts/fetch-real-fixtures.mjs",
    "qa": "node scripts/qa.mjs",
    "qa:ci": "node scripts/qa.mjs --synthetic-only",
